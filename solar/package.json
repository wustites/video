{
  "name": "solar-vertical",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes hyperframes@0.6.112 preview",
    "voiceover": "python scripts/generate_voiceover.py",
    "sync:validate": "python scripts/validate_sync.py",
    "lint": "npx --yes hyperframes@0.6.112 lint",
    "validate": "npx --yes hyperframes@0.6.112 validate",
    "inspect": "npx --yes hyperframes@0.6.112 inspect --samples 10",
    "check": "npm run sync:validate && npm run lint && npm run validate && npm run inspect",
    "render:en": "npx --yes hyperframes@0.6.112 render -c compositions/en.html -o out/solar-system-en-vertical.mp4",
    "render:zh": "npx --yes hyperframes@0.6.112 render -c compositions/zh.html -o out/solar-system-zh-vertical.mp4",
    "render:ja": "npx --yes hyperframes@0.6.112 render -c compositions/ja.html -o out/solar-system-ja-vertical.mp4",
    "render:ko": "npx --yes hyperframes@0.6.112 render -c compositions/ko.html -o out/solar-system-ko-vertical.mp4"
  }
}
