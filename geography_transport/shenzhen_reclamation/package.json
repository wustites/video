{
  "name": "shenzhen-reclamation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "hyperframes preview",
    "check": "hyperframes check",
    "voiceover": "python3 ../../packages/voiceover/edge_narration.py --voice zh-CN-YunxiNeural --lang zh --rate=+5% --word-marks --expected 7 && python3 build.py",
    "build": "python3 build.py",
    "render": "hyperframes render --quality delivery --output out/shenzhen-reclamation-zh.mp4",
    "render:draft": "hyperframes render --quality draft --output out/preview.mp4"
  },
  "devDependencies": {
    "hyperframes": "0.8.174"
  }
}
