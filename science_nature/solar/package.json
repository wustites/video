{
  "name": "solar-vertical",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "check": "tsc --noEmit",
    "voiceover": "python scripts/generate_voiceover.py",
    "render": "remotion render solar-en out/video.mp4",
    "render:draft": "remotion render solar-en out/preview.mp4 --log=error",
    "render:en": "remotion render solar-en out/solar-system-en-vertical.mp4",
    "render:zh": "remotion render solar-zh out/solar-system-zh-vertical.mp4",
    "render:ja": "remotion render solar-ja out/solar-system-ja-vertical.mp4",
    "render:ko": "remotion render solar-ko out/solar-system-ko-vertical.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.504",
    "@remotion/google-fonts": "4.0.504",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.504",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "0.160.0",
    "typescript": "^5.8.3"
  }
}
