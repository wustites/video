{
  "name": "openrouter-rankings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "check": "tsc --noEmit",
    "render": "remotion render OpenrouterRankingsEn out/video.mp4",
    "render:en": "remotion render OpenrouterRankingsEn out/openrouter-rankings-en.mp4",
    "render:zh": "remotion render OpenrouterRankingsZh out/openrouter-rankings-zh.mp4",
    "render:draft": "remotion render OpenrouterRankingsEn out/preview.mp4 --log=error",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.504",
    "@remotion/google-fonts": "4.0.504",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.504"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3"
  }
}
